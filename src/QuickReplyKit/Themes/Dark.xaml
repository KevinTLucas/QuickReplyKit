<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme. Keys mirror Light.xaml exactly. -->
    <SolidColorBrush x:Key="WindowBg" Color="#FF1E1E24"/>
    <SolidColorBrush x:Key="CardBg" Color="#FF2A2A33"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FF3C3C48"/>
    <SolidColorBrush x:Key="Accent" Color="#FF7B74F5"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF0F0F5"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF9E9EB4"/>
    <SolidColorBrush x:Key="Selection" Color="#FF3A3A52"/>
    <SolidColorBrush x:Key="Disabled" Color="#FF55555F"/>
    <SolidColorBrush x:Key="Warning" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="Error" Color="#FFF87171"/>
    <SolidColorBrush x:Key="Danger" Color="#FFE05252"/>
    <SolidColorBrush x:Key="Favorite" Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="Hyperlink" Color="#FF9DABFF"/>

    <!-- Selected-item highlight in list/tree controls: default templates read these SystemColors
         keys via DynamicResource, so overriding them here re-themes selection app-wide. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF454569"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF0F0F5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A3A52"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF0F0F5"/>

    <!-- Themes the editable ComboBox text area (its inner TextBox ignores ComboBox.Background).
         Only reaches TextBoxes without an explicit Style, so styled fields are untouched. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- Default control chrome (editable ComboBox / ComboBox popup paint these SystemColors,
         not the control's Background). Overriding here darkens them app-wide in dark mode. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2A2A33"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF0F0F5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF0F0F5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF9E9EB4"/>
</ResourceDictionary>
