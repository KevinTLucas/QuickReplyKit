<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme. Keys mirror Dark.xaml exactly. -->
    <SolidColorBrush x:Key="WindowBg" Color="#FFF4F4F8"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FFE2E2EC"/>
    <SolidColorBrush x:Key="Accent" Color="#FF4F46E5"/>
    <SolidColorBrush x:Key="PrimaryButtonBg" Color="#FF4F46E5"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1A1A22"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF8A8AA0"/>
    <SolidColorBrush x:Key="Selection" Color="#FFEBEAFB"/>
    <SolidColorBrush x:Key="Disabled" Color="#FFB8B8C4"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB45309"/>
    <SolidColorBrush x:Key="Error" Color="#FFB91C1C"/>
    <SolidColorBrush x:Key="Danger" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="Favorite" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="Hyperlink" Color="#FF4F46E5"/>
    <SolidColorBrush x:Key="ButtonHoverOverlay" Color="#14000000"/>
    <SolidColorBrush x:Key="ButtonPressedOverlay" Color="#26000000"/>
    <SolidColorBrush x:Key="ButtonOutlineOuter" Color="#FF000000"/>
    <SolidColorBrush x:Key="ButtonOutlineInner" Color="#FFFFFFFF"/>

    <!-- Selected-item highlight in list/tree controls: default templates read these SystemColors
         keys via DynamicResource, so overriding them here re-themes selection app-wide. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFEBEAFB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF1A1A22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFECECF2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF1A1A22"/>

    <!-- Themes the editable ComboBox text area (its inner TextBox ignores ComboBox.Background).
         Only reaches TextBoxes without an explicit Style, so styled fields are untouched. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- Default control chrome (editable ComboBox / ComboBox popup paint these SystemColors,
         not the control's Background). Light values match the WPF defaults. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FF1A1A22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FF1A1A22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF8A8AA0"/>
</ResourceDictionary>
