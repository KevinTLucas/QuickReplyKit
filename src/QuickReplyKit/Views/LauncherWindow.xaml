<Window x:Class="QuickReplyKit.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickReplyKit.ViewModels"
        xmlns:views="clr-namespace:QuickReplyKit.Views"
        Title="QuickReplyKit"
        Width="780" Height="520"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="72"/>
        </Style>

        <Style x:Key="FavoriteToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Favorite}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav category right-click menu (suppressed for the fixed Favorites/Recent/All nodes) -->
        <ContextMenu x:Key="NavContextMenu">
            <MenuItem Header="Export folder…" Click="MenuExportFolder_Click"/>
            <Separator/>
            <MenuItem Header="_Delete folder…" Click="MenuDeleteFolder_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: nav toggle, search, settings gear -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="6,4"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="NavToggle" Content="☰" Style="{StaticResource IconButton}"
                        AutomationProperties.Name="Show/hide the navigation pane"
                        ToolTip="Show/hide the navigation pane" Click="NavToggle_Click"/>
                <TextBlock Grid.Column="1" Text="🔍" FontSize="14" Margin="4,0,8,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                <DockPanel Grid.Column="2" LastChildFill="True">
                    <Border DockPanel.Dock="Left" MaxWidth="150" Margin="0,0,6,0" Padding="5,1,2,1"
                            CornerRadius="3" Background="{DynamicResource Selection}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Visibility="{Binding HasSearchScope, Converter={StaticResource BoolVis}}"
                            AutomationProperties.Name="{Binding SearchScopeLabel, StringFormat=Search in folder {0}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource IconButton}"
                                    Padding="3,0" Margin="3,0,0,0"
                                    AutomationProperties.Name="Remove folder search filter"
                                    ToolTip="Remove folder search filter"
                                    Click="ClearSearchScope_Click"/>
                            <TextBlock Text="{Binding SearchScopeLabel}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip="{Binding CurrentCategory}"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TextBox x:Name="SearchBox" TabIndex="0" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                                 FontSize="15" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search responses"
                                 AutomationProperties.HelpText="Type to filter responses; use arrow keys to choose a result"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <TextBlock Text="Search responses…" IsHitTestVisible="False"
                                   VerticalAlignment="Center" FontSize="15"
                                   Foreground="{DynamicResource TextMuted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Query}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <Button Grid.Column="3" x:Name="NewButton" Content="＋" Style="{StaticResource IconButton}"
                        Foreground="{DynamicResource Accent}" FontSize="18"
                        AutomationProperties.Name="New response"
                        ToolTip="New response" Click="NewButton_Click"/>
                <Button Grid.Column="4" x:Name="NewFromClipboardButton" Content="📋" Style="{StaticResource IconButton}"
                        AutomationProperties.Name="New response from clipboard"
                        ToolTip="New response from clipboard" Click="NewFromClipboardButton_Click"/>
                <Button Grid.Column="5" x:Name="ImportExportButton" Style="{StaticResource IconButton}"
                        Padding="6,2" AutomationProperties.Name="Import and export responses"
                        ToolTip="Import responses or export the full library"
                        Click="ImportExportButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⇄" FontSize="16" Margin="0,0,4,0"
                                   Foreground="{DynamicResource Accent}"/>
                        <AccessText Text="_Import / Export" FontSize="12"
                                    Foreground="{DynamicResource TextPrimary}"
                                    VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Import responses…" Click="MenuImport_Click"/>
                            <MenuItem Header="Export _full library…" Click="MenuExportLibrary_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="6" x:Name="SettingsButton" Content="⚙" Style="{StaticResource IconButton}"
                        AutomationProperties.Name="Settings"
                        ToolTip="Settings" Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <!-- Main: Nav | Results | Preview -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="180" MinWidth="140"/>
                <ColumnDefinition x:Name="NavSplitterColumn" Width="Auto"/>
                <ColumnDefinition Width="1.3*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.7*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Nav pane -->
            <Border Grid.Column="0" x:Name="NavBorder" Background="{DynamicResource CardBg}" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <TreeView x:Name="NavTree" BorderThickness="0" Background="Transparent"
                          AutomationProperties.Name="Response folders and views"
                          AutomationProperties.HelpText="Choose All Responses, Favorites, Recent, or a folder"
                          Foreground="{DynamicResource TextPrimary}"
                          ItemsSource="{Binding NavRoots}"
                          SelectedItemChanged="NavTree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="NavTree_PreviewMouseRightButtonDown"
                          ContextMenuOpening="NavTree_ContextMenuOpening"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:NavNodeVm}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="2,3"/>
                            <Setter Property="ContextMenu" Value="{StaticResource NavContextMenu}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" x:Name="NavSplitter" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Results pane -->
            <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="ResultsList" TabIndex="1" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Response results"
                             AutomationProperties.HelpText="Use arrow keys to select; Enter pastes the selected response"
                             Foreground="{DynamicResource TextPrimary}"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ResultsList_MouseDoubleClick"
                             PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown"
                             ContextMenuOpening="ResultsList_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="ResultsContextMenu">
                                <MenuItem x:Name="MenuEdit" Header="Edit…" Click="MenuEdit_Click"/>
                                <MenuItem x:Name="MenuEditInsert" Header="Edit &amp; insert…"
                                          Click="MenuEditInsert_Click"/>
                                <MenuItem x:Name="MenuDuplicate" Header="Duplicate" Click="MenuDuplicate_Click"/>
                                <MenuItem x:Name="MenuRename" Header="Rename…" Click="MenuRename_Click"/>
                                <MenuItem x:Name="MenuMove" Header="Move to…" Click="MenuMove_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuAssignHotkey" Header="Instant-paste hotkey…"
                                          Click="MenuAssignHotkey_Click"/>
                                <MenuItem x:Name="MenuClearHotkey" Header="Clear instant-paste hotkey"
                                          Click="MenuClearHotkey_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuCopy" Header="Copy" Click="MenuCopy_Click"/>
                                <MenuItem x:Name="MenuExportResponse" Header="Export response…"
                                          Click="MenuExportResponse_Click"/>
                                <MenuItem x:Name="MenuOpenFolder" Header="Open containing folder"
                                          Click="MenuOpenFolder_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuDelete" Header="Delete…" Click="MenuDelete_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ResponseRowVm}">
                                <Grid Margin="2,3" AutomationProperties.Name="{Binding Name}"
                                      AutomationProperties.HelpText="{Binding Subtitle}">
                                    <Grid.Style>
                                        <!-- Invalid rows are muted (but the ⚠ stays legible). -->
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠" Foreground="{DynamicResource Warning}"
                                               Margin="0,0,6,0" VerticalAlignment="Center"
                                               Visibility="{Binding ShowStatusGlyph, Converter={StaticResource BoolVis}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock views:HighlightText.Segments="{Binding NameSegments}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" Content="{Binding FavoriteGlyph}"
                                            Command="{Binding ToggleFavoriteCommand}" IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                            Style="{StaticResource FavoriteToggle}" FontSize="15"
                                            VerticalAlignment="Center" ToolTip="Toggle favorite"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Toggle favorite for {0}}"
                                            Visibility="{Binding IsValid, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding EmptyStateText}" TextWrapping="Wrap" TextAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource TextMuted}" MaxWidth="240"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmptyState, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Preview pane -->
            <Border Grid.Column="4" Background="{DynamicResource CardBg}" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="↳ contains variables — resolved on insert"
                                       AutomationProperties.LiveSetting="Polite"
                                       Foreground="{DynamicResource TextMuted}" FontStyle="Italic"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding SelectionHasVariables, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding PreviewMeta}" Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding HasPreviewMeta, Converter={StaticResource BoolVis}}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Paste" TabIndex="3" Style="{StaticResource ActionButton}"
                                        Command="{Binding PasteCommand}" ToolTip="Enter — paste (rich text)"/>
                                <Button Content="Paste plain" TabIndex="4" Style="{StaticResource ActionButton}"
                                        Command="{Binding PastePlainCommand}" ToolTip="Shift+Enter — paste as plain text"/>
                                <Button Content="Copy" TabIndex="5" Style="{StaticResource ActionButton}"
                                        Command="{Binding CopyCommand}" ToolTip="Ctrl+C — copy to clipboard"/>
                                <Button Content="✎ Edit" TabIndex="6" Style="{StaticResource ActionButton}"
                                        Click="MenuEdit_Click" IsEnabled="{Binding HasValidSelection}"
                                        ToolTip="Edit this response in the rich-text editor"
                                        AutomationProperties.Name="Edit response"/>
                                <TextBlock Text="{Binding CopiedHint}" Foreground="{DynamicResource Accent}"
                                           AutomationProperties.LiveSetting="Polite"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Visibility="{Binding HasCopiedHint, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <FlowDocumentScrollViewer x:Name="PreviewViewer" TabIndex="2"
                                              AutomationProperties.Name="Response preview"
                                              AutomationProperties.HelpText="Preview of the selected response as it will be inserted"
                                              Document="{Binding PreviewDocument}"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Background="{DynamicResource CardBg}"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                        <FlowDocumentScrollViewer.Resources>
                            <Style TargetType="Hyperlink">
                                <Setter Property="Foreground" Value="{DynamicResource Hyperlink}"/>
                            </Style>
                        </FlowDocumentScrollViewer.Resources>
                    </FlowDocumentScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
