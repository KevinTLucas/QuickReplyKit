<Window x:Class="QuickReplyKit.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickReplyKit.ViewModels"
        Title="QuickReplyKit"
        Width="780" Height="520"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="#FFF4F4F8"
        FontFamily="Segoe UI"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Muted secondary text -->
        <SolidColorBrush x:Key="Muted" Color="#FF8A8AA0"/>
        <SolidColorBrush x:Key="CardBorder" Color="#FFE2E2EC"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4F46E5"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: nav toggle, search, settings gear -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="6,4"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="NavToggle" Content="☰" Style="{StaticResource IconButton}"
                        ToolTip="Show/hide the navigation pane" Click="NavToggle_Click"/>
                <TextBlock Grid.Column="1" Text="🔍" FontSize="14" Margin="4,0,8,0"
                           VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                <TextBox Grid.Column="2" x:Name="SearchBox" TabIndex="0" BorderThickness="0"
                         Background="Transparent" FontSize="15" VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <Button Grid.Column="3" x:Name="SettingsButton" Content="⚙" Style="{StaticResource IconButton}"
                        ToolTip="Open the response library folder (settings coming later)"
                        Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <!-- Search box placeholder -->
        <TextBlock Grid.Row="0" Text="Search responses…" IsHitTestVisible="False"
                   Margin="70,0,0,0" VerticalAlignment="Center" FontSize="15"
                   Foreground="{StaticResource Muted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Query}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Main: Nav | Results | Preview -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="180" MinWidth="140"/>
                <ColumnDefinition x:Name="NavSplitterColumn" Width="Auto"/>
                <ColumnDefinition Width="1.3*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.7*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Nav pane -->
            <Border Grid.Column="0" x:Name="NavBorder" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <TreeView x:Name="NavTree" BorderThickness="0" Background="Transparent"
                          ItemsSource="{Binding NavRoots}"
                          SelectedItemChanged="NavTree_SelectedItemChanged"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:NavNodeVm}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="2,3"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" x:Name="NavSplitter" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Results pane -->
            <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="ResultsList" TabIndex="1" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ResponseRowVm}">
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠" Foreground="#FFB45309"
                                               Margin="0,0,6,0" VerticalAlignment="Center"
                                               Visibility="{Binding ShowStatusGlyph, Converter={StaticResource BoolVis}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding FavoriteGlyph}"
                                            Command="{Binding ToggleFavoriteCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="#FFF59E0B" FontSize="15" Padding="6,0"
                                            VerticalAlignment="Center" ToolTip="Toggle favorite"
                                            Visibility="{Binding IsValid, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding EmptyStateText}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource Muted}" MaxWidth="240"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmptyState, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Preview pane -->
            <Border Grid.Column="4" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewMeta}" Foreground="{StaticResource Muted}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding HasPreviewMeta, Converter={StaticResource BoolVis}}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Paste" TabIndex="3" Style="{StaticResource ActionButton}"
                                        Command="{Binding PasteCommand}" ToolTip="Enter — paste (rich text)"/>
                                <Button Content="Paste plain" TabIndex="4" Style="{StaticResource ActionButton}"
                                        Command="{Binding PastePlainCommand}" ToolTip="Shift+Enter — paste as plain text"/>
                                <Button Content="Copy" TabIndex="5" Style="{StaticResource ActionButton}"
                                        Command="{Binding CopyCommand}" ToolTip="Ctrl+C — copy to clipboard"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <FlowDocumentScrollViewer x:Name="PreviewViewer" TabIndex="2"
                                              Document="{Binding PreviewDocument}"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
