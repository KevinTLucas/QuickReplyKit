<Window x:Class="QuickReplyKit.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import preview" SizeToContent="Height" Width="520" MaxHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18,14,18,16">
        <TextBlock x:Name="Summary" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="6" Margin="0,10,0,0">
            <ListBox x:Name="EntryList" MaxHeight="280" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding Badge}" CornerRadius="4" Padding="6,1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" Foreground="Black" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Dest}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Dest}" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel x:Name="ConflictPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="For items that already exist (changed):" Foreground="{DynamicResource TextMuted}"
                       FontSize="12" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PolicySkip" Content="Skip (keep mine)" GroupName="P" IsChecked="True" Margin="0,0,16,0"/>
                <RadioButton x:Name="PolicyOverwrite" Content="Overwrite (use theirs)" GroupName="P" Margin="0,0,16,0"/>
                <RadioButton x:Name="PolicyKeepBoth" Content="Keep both" GroupName="P"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ImportButton" Content="Import" Style="{StaticResource Primary}" Click="Import_Click"/>
            <Button Content="Cancel" Style="{StaticResource Btn}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
