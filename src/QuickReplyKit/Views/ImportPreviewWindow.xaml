<Window x:Class="QuickReplyKit.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickReplyKit.Views"
        Title="Import preview" SizeToContent="Height" Width="600" MinWidth="420" MinHeight="320" MaxHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBg}"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18,14,18,16">
        <TextBlock x:Name="Summary" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   views:LiveRegion.Content="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="6" Margin="0,10,0,0">
            <ListBox x:Name="EntryList" MaxHeight="280" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Import changes"
                     AutomationProperties.HelpText="Review each item and choose whether to import it"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="118"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding Badge}" CornerRadius="4" Padding="6,1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" Foreground="Black" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="{Binding Dest}" Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Dest}"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMuted}"
                                           FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="Import action"
                                      SelectedValuePath="Action" SelectedValue="{Binding Action, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChoose}" SelectionChanged="Action_Changed"
                                      MinWidth="108" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel x:Name="ConflictPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="Apply one choice to all changed items:" Foreground="{DynamicResource TextMuted}"
                       FontSize="12" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PolicySkip" Content="Skip (keep mine)" GroupName="P" IsChecked="True" Margin="0,0,16,0"/>
                <RadioButton x:Name="PolicyOverwrite" Content="Overwrite (use theirs)" GroupName="P" Margin="0,0,16,0"/>
                <RadioButton x:Name="PolicyKeepBoth" Content="Keep both" GroupName="P" Margin="0,0,12,0"/>
                <Button Content="Apply" Style="{StaticResource Btn}" Margin="0" Padding="10,3"
                        Click="ApplyConflicts_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ImportButton" Content="Import" Style="{StaticResource Primary}" IsDefault="True"
                    Click="Import_Click"/>
            <Button Content="Cancel" Style="{StaticResource Btn}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
