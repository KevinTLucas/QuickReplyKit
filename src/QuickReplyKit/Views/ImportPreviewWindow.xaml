<Window x:Class="QuickReplyKit.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickReplyKit.Views"
        Title="Import preview" Width="760" Height="540" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBg}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Summary" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionSummary" Text="{Binding SelectedSummary}"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                       AutomationProperties.LiveSetting="Polite"
                       views:LiveRegion.Content="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Select all safe" Style="{StaticResource Btn}" Margin="0"
                        AutomationProperties.Name="Select all importable responses; scripts are never bulk selected"
                        Click="SelectAll_Click"/>
                <Button Content="Clear" Style="{StaticResource Btn}"
                        AutomationProperties.Name="Clear import selection"
                        Click="Clear_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="EntryList" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Import changes"
                     AutomationProperties.HelpText="Review each response, select what to import, and choose how changed responses are handled"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="126"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding SelectionName}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel Grid.Column="2" Margin="8,0">
                                <TextBlock Text="{Binding DestinationPath}" Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DestinationPath}"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMuted}"
                                           FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding ConflictChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Action" SelectedValue="{Binding ConflictAction, Mode=TwoWay}"
                                      IsEnabled="{Binding IsConflictChoiceEnabled}"
                                      Visibility="{Binding IsConflict, Converter={StaticResource BoolToVis}}"
                                      AutomationProperties.Name="{Binding ConflictActionName}"
                                      MinWidth="116" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,2" Padding="10,8"
                                    Visibility="{Binding IsScript, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Warning}"
                                    BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="Executable expression — review before accepting"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/>
                                    <TextBox Text="{Binding CodeSource}" Margin="0,6,0,0" MinHeight="58" MaxHeight="128"
                                             IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Exact executable expression"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource Btn}" IsCancel="True"/>
            <Button x:Name="ImportButton" Content="Import selected" Style="{StaticResource Primary}"
                    IsDefault="True" IsEnabled="{Binding CanImport}" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
