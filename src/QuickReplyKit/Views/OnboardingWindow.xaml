<Window x:Class="QuickReplyKit.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to QuickReplyKit" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="72"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBg}"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,22,24,18">
        <TextBlock x:Name="Emoji" Text="👋" FontSize="40" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Margin="0,8,0,0" TextAlignment="Center"/>
        <TextBlock x:Name="Body" FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,8,0,0" MinHeight="66"/>
        <TextBlock x:Name="Dots" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,0"
                   Foreground="{DynamicResource TextMuted}"/>
        <Grid Margin="0,16,0,0">
            <Button Content="Skip" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0"
                    Click="Skip_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Style="{StaticResource Btn}" Click="Back_Click"/>
                <Button x:Name="NextButton" Content="Next" Style="{StaticResource Primary}" Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
