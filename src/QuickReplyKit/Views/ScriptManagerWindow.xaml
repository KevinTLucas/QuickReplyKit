<Window x:Class="QuickReplyKit.Views.ScriptManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickReplyKit.Views"
        Title="Scripts" Width="780" Height="580" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Scripts" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a restricted QuickReplyKit expression or full-trust Windows PowerShell. Scripts run only after local trust approval."
                           Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="New script" Style="{StaticResource Btn}" Margin="12,0,0,0"
                    Click="New_Click" AutomationProperties.Name="Create a new script"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="190" MaxWidth="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    Background="{DynamicResource CardBg}">
                <ListBox x:Name="ScriptList" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Script definitions"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ScriptList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Status}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="7,5" ToolTip="{Binding RelativePath}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                <TextBlock Text="{Binding Status}" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Status}"/>
                                <TextBlock Text="{Binding RelativePath}" FontSize="10"
                                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativePath}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          AutomationProperties.Name="Resize script list and editor"
                          Background="{DynamicResource CardBorder}"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource Field}" MaxLength="128"
                                 AutomationProperties.Name="Script name" TextChanged="Draft_Changed"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="EnabledCheck" Content="Enabled" Margin="12,22,0,0"
                              VerticalAlignment="Center" Checked="Draft_Changed" Unchecked="Draft_Changed"/>
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Language" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="LanguageBox"
                              AutomationProperties.Name="Script language"
                              SelectionChanged="Language_Changed">
                        <ComboBoxItem Content="Restricted QuickReplyKit expression" Tag="qrk-expr-1"/>
                        <ComboBoxItem Content="Full-trust Windows PowerShell" Tag="powershell-1"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Row="2" x:Name="SourceLabel" Text="Expression source" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="3" x:Name="ExpressionBox" Style="{StaticResource Field}"
                         AutomationProperties.Name="Exact script expression source"
                         AutomationProperties.HelpText="Restricted QuickReplyKit expression language; no operating-system or network access"
                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="13"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="Draft_Changed"/>

                <StackPanel Grid.Row="4" Margin="0,8,0,0">
                    <Border x:Name="NativeWarning" Visibility="Collapsed" Padding="10,8" Margin="0,0,0,8"
                            Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Warning}"
                            BorderThickness="2" CornerRadius="4"
                            AutomationProperties.Name="Full-trust Windows PowerShell security warning">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                                   Text="Full-trust Windows PowerShell runs as your signed-in Windows user. It can read, change, or delete files; access the network, registry, environment, and credentials; and start processes. Only trust code you have reviewed."/>
                    </Border>
                    <TextBlock x:Name="TrustState" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               AutomationProperties.LiveSetting="Assertive"
                               views:LiveRegion.Content="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>

                <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="ValidateButton" Content="Validate" Style="{StaticResource Btn}" Click="Validate_Click"/>
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource Btn}" Click="Save_Click"/>
                    <Button x:Name="SaveTrustButton" Content="Save &amp; trust" Style="{StaticResource Btn}"
                            Click="SaveTrust_Click" ToolTip="Save, reload, then trust this exact script only"/>
                    <Button x:Name="TrustButton" Content="Trust" Style="{StaticResource Btn}" Click="Trust_Click"
                            ToolTip="Trust this exact saved source only"/>
                </WrapPanel>
            </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel>
                <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource Btn}" Margin="0"
                        Click="Delete_Click"/>
                <Button x:Name="ExportButton" Content="Export…" Style="{StaticResource Btn}" Click="Export_Click"/>
            </WrapPanel>
            <Button Grid.Column="1" Content="Close" Style="{StaticResource Btn}" IsDefault="True"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
