<Window x:Class="QuickReplyKit.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF4F4F8" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBorder" Color="#FFE2E2EC"/>
        <SolidColorBrush x:Key="Muted" Color="#FF8A8AA0"/>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">

        <!-- Global hotkey -->
        <TextBlock Text="Global hotkey" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
        <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 FontSize="14" Padding="8,6" Cursor="Hand" Background="White"
                 BorderBrush="{StaticResource CardBorder}"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"
                 LostKeyboardFocus="HotkeyBox_LostFocus"/>
        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}"
                   Text="Click, then press the key combination you want (e.g. Ctrl+Alt+D)."/>
        <TextBlock x:Name="HotkeyError" Foreground="#FFB91C1C" FontSize="12" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="Collapsed"/>

        <!-- Library path -->
        <TextBlock Text="Response library folder" Style="{StaticResource SectionLabel}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="LibraryPathBox" IsReadOnly="True" FontSize="13"
                     Padding="8,6" VerticalContentAlignment="Center" Background="White"
                     BorderBrush="{StaticResource CardBorder}"/>
            <Button Grid.Column="1" Content="Change…" Style="{StaticResource ActionButton}"
                    Click="ChangeLibrary_Click"/>
            <Button Grid.Column="2" Content="Open" Style="{StaticResource ActionButton}"
                    ToolTip="Open this folder in Explorer" Click="OpenLibrary_Click"/>
        </Grid>

        <!-- Default paste behaviour -->
        <TextBlock Text="Default paste behaviour" Style="{StaticResource SectionLabel}"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PasteRich" Content="Rich text" GroupName="Paste" Margin="0,0,20,0" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="PastePlain" Content="Plain text" GroupName="Paste" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="What Enter does when you insert a response."/>

        <!-- Toggles -->
        <CheckBox x:Name="RememberWindowCheck" Content="Remember window size &amp; position" Margin="0,16,0,0"/>
        <CheckBox x:Name="StartupCheck" Content="Launch at Windows startup" Margin="0,10,0,0"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Style="{StaticResource ActionButton}" Margin="0,0,0,0"
                    IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
