<Window x:Class="QuickReplyKit.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" Height="640" MinWidth="420" MinHeight="320"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="18,14,18,10">
        <StackPanel>

        <!-- Global hotkey -->
        <TextBlock Text="Global hotkey" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
        <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 FontSize="14" Padding="8,6" Cursor="Hand" Style="{StaticResource Input}"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"
                 LostKeyboardFocus="HotkeyBox_LostFocus"/>
        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}"
                   Text="Click, then press the key combination you want (e.g. Ctrl+Alt+D)."/>
        <TextBlock x:Name="HotkeyError" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="Collapsed"/>
        <Button Content="Keyboard shortcuts…" HorizontalAlignment="Left" Margin="0,8,0,0"
                Style="{StaticResource ActionButton}" Click="ManageHotkeys_Click"
                ToolTip="See every shortcut, assign per-response instant-paste keys, and check for conflicts."/>

        <!-- Library path -->
        <TextBlock Text="Response library folder" Style="{StaticResource SectionLabel}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="LibraryPathBox" IsReadOnly="True" FontSize="13"
                     Padding="8,6" VerticalContentAlignment="Center" Style="{StaticResource Input}"/>
            <Button Grid.Column="1" Content="Change…" Style="{StaticResource ActionButton}"
                    Click="ChangeLibrary_Click"/>
            <Button Grid.Column="2" Content="Open" Style="{StaticResource ActionButton}"
                    ToolTip="Open this folder in Explorer" Click="OpenLibrary_Click"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Back up / Restore Library…" Style="{StaticResource ActionButton}"
                    Margin="0" Click="Backup_Click"
                    ToolTip="Snapshot the library or roll back to an earlier snapshot"/>
            <Button Content="Trash…" Style="{StaticResource ActionButton}"
                    ToolTip="Restore or permanently remove deleted responses" Click="Trash_Click"/>
        </StackPanel>

        <!-- Default paste behaviour -->
        <TextBlock Text="Default paste behaviour" Style="{StaticResource SectionLabel}"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PasteRich" Content="Rich text" GroupName="Paste" Margin="0,0,20,0" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="PastePlain" Content="Plain text" GroupName="Paste" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="What Enter does when you insert a response."/>

        <!-- Theme -->
        <TextBlock Text="Appearance" Style="{StaticResource SectionLabel}"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ThemeSystem" Content="System" GroupName="Theme" Margin="0,0,20,0"
                         VerticalContentAlignment="Center" Checked="Theme_Changed"/>
            <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Margin="0,0,20,0"
                         VerticalContentAlignment="Center" Checked="Theme_Changed"/>
            <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme"
                         VerticalContentAlignment="Center" Checked="Theme_Changed"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="System follows your Windows light/dark setting."/>

        <!-- Toggles -->
        <CheckBox x:Name="RememberWindowCheck" Content="Remember window size &amp; position" Margin="0,16,0,0"/>
        <CheckBox x:Name="StartupCheck" Content="Launch at Windows startup" Margin="0,10,0,0"/>

        <!-- Diagnostics -->
        <TextBlock Text="Diagnostics" Style="{StaticResource SectionLabel}"/>
        <CheckBox x:Name="VerboseLogCheck" Content="Verbose (debug) logging"/>
        <StackPanel Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Hint}" Margin="0"
                       Text="Off = errors/info only. On = log every action (hotkey, search, paste, scan…) for troubleshooting. Rolling, ~50 MB max."/>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="About / Diagnostics…" Style="{StaticResource ActionButton}" Click="About_Click"/>
                <Button Content="Open logs folder" Style="{StaticResource ActionButton}" Click="OpenLogs_Click"/>
            </WrapPanel>
        </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- Actions remain reachable while the settings above scroll. -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="18,10,18,12" Background="{DynamicResource WindowBg}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Style="{StaticResource ActionButton}" Margin="0,0,0,0"
                    IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"/>
        </StackPanel>
        </Border>
    </Grid>
</Window>
