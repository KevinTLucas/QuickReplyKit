<Window x:Class="QuickReplyKit.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About / Diagnostics" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="QuickReplyKit" FontWeight="SemiBold" FontSize="18"/>
        <TextBlock x:Name="TagLine" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,10"
                   Text="Response launcher — diagnostics"/>

        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="6" Padding="2">
            <TextBox x:Name="DiagText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas,Cascadia Mono,monospace"
                     FontSize="12" Padding="8" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     MaxHeight="320" IsReadOnlyCaretVisible="False"/>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Open logs folder" Style="{StaticResource Btn}" Click="OpenLogs_Click"/>
            <Button Content="Open config folder" Style="{StaticResource Btn}" Click="OpenConfig_Click"/>
            <Button Content="Open library" Style="{StaticResource Btn}" Click="OpenLibrary_Click"/>
            <Button Content="Copy" Style="{StaticResource Btn}" ToolTip="Copy this diagnostics text" Click="Copy_Click"/>
            <Button Content="Close" Style="{StaticResource Btn}" Margin="0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
