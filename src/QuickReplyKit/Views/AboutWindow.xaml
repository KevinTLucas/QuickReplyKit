<Window x:Class="QuickReplyKit.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About / Diagnostics" Width="620" Height="500" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="QuickReplyKit" FontWeight="SemiBold" FontSize="18"/>
        <TextBlock Grid.Row="1" x:Name="TagLine" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,10"
                   Text="Response launcher — diagnostics"/>

        <Border Grid.Row="2" x:Name="DiagnosticsBorder" Background="{DynamicResource CardBg}"
                CornerRadius="6" Padding="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DiagText}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBox x:Name="DiagText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Diagnostic information"
                     AutomationProperties.HelpText="Read-only system and QuickReplyKit status information"
                     Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas,Cascadia Mono,monospace"
                     FontSize="12" Padding="8" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     IsReadOnlyCaretVisible="False"/>
        </Border>

        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,-8">
            <Button Content="Open logs folder" Style="{StaticResource Btn}" Click="OpenLogs_Click"/>
            <Button Content="Open config folder" Style="{StaticResource Btn}" Click="OpenConfig_Click"/>
            <Button Content="Open library" Style="{StaticResource Btn}" Click="OpenLibrary_Click"/>
            <Button Content="Open backup folder" Style="{StaticResource Btn}" Click="OpenBackup_Click"/>
            <Button Content="Open trash folder" Style="{StaticResource Btn}" Click="OpenTrash_Click"/>
            <Button Content="Copy" Style="{StaticResource Btn}" ToolTip="Copy this diagnostics text" Click="Copy_Click"/>
        </WrapPanel>
    </Grid>
</Window>
