<Window x:Class="QuickReplyKit.Views.AssignHotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign hotkey" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="Instant-paste hotkey for:" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
        <TextBlock x:Name="ResponseName" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                   Margin="0,2,0,10"/>

        <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 FontSize="14" Padding="8,6" Cursor="Hand"
                 Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource CardBorder}"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"
                 LostKeyboardFocus="HotkeyBox_LostFocus"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Click, then press the key combination (e.g. Ctrl+Alt+1). It pastes this response straight into whatever app you're in, without opening QuickReplyKit."/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,6,0,0" Visibility="Collapsed"/>

        <TextBlock Text="Paste as" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,4"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PasteRich" Content="Rich text" GroupName="Paste" Margin="0,0,20,0"
                         VerticalContentAlignment="Center" IsChecked="True"/>
            <RadioButton x:Name="PastePlain" Content="Plain text" GroupName="Paste"
                         VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource ActionButton}"
                    Click="Remove_Click"/>
            <Button Content="Save" Style="{StaticResource ActionButton}" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
