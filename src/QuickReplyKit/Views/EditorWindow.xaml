<Window x:Class="QuickReplyKit.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickReplyKit.Views"
        Title="Edit response"
        Width="640" Height="560" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0,0,2"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                            <Border x:Name="State" Background="Transparent" CornerRadius="4"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="FocusOutline" BorderBrush="{DynamicResource ButtonOutlineOuter}"
                                    BorderThickness="0" CornerRadius="4" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="State" Property="Background"
                                        Value="{DynamicResource ButtonHoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="State" Property="Background"
                                        Value="{DynamicResource ButtonHoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="88"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBg}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name + Category -->
        <Grid x:Name="MetaRow1" Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Field}"
                         AutomationProperties.Name="Response name"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Category (folder — type a new path to create it)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryBox" IsEditable="True" StaysOpenOnEdit="True"
                          AutomationProperties.Name="Response category"
                          AutomationProperties.HelpText="Choose a folder or type a new folder path"/>
            </StackPanel>
        </Grid>

        <!-- App + Tags -->
        <Grid x:Name="MetaRow2" Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="App (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AppBox" Style="{StaticResource Field}"
                         AutomationProperties.Name="Application name"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Tags (type + Enter)" Style="{StaticResource FieldLabel}"/>
                <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        Background="{DynamicResource CardBg}" CornerRadius="3" Padding="3,2" MinHeight="28">
                    <WrapPanel x:Name="TagsPanel" Orientation="Horizontal">
                        <TextBox x:Name="TagInput" BorderThickness="0" Background="Transparent" MinWidth="70"
                                 Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                 VerticalContentAlignment="Center" FontSize="13" Margin="2,1"
                                 AutomationProperties.Name="Response tags"
                                 AutomationProperties.HelpText="Type a tag and press Enter; Backspace removes the last tag"
                                 PreviewKeyDown="TagInput_PreviewKeyDown" LostFocus="TagInput_LostFocus"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Formatting toolbar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" CornerRadius="8,8,0,0"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,1,1,0" Padding="8,6">
            <WrapPanel Orientation="Horizontal">
                <ToggleButton x:Name="BoldButton" Style="{StaticResource ToolToggle}" IsThreeState="True"
                        FontWeight="Bold" Content="B" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold"
                        Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Body}"/>
                <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToolToggle}" IsThreeState="True"
                        FontStyle="Italic" Content="I" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic"
                        Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Body}">
                    <ToggleButton.Resources>
                        <Style TargetType="TextBlock"><Setter Property="FontStyle" Value="Italic"/></Style>
                    </ToggleButton.Resources>
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton" Style="{StaticResource ToolToggle}" IsThreeState="True"
                        Content="U" ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline"
                        Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Body}">
                    <ToggleButton.Resources>
                        <Style TargetType="TextBlock"><Setter Property="TextDecorations" Value="Underline"/></Style>
                    </ToggleButton.Resources>
                </ToggleButton>
                <ToggleButton x:Name="StrikeButton" Style="{StaticResource ToolToggle}" IsThreeState="True"
                        Content="S" ToolTip="Strikethrough" AutomationProperties.Name="Strikethrough"
                        Click="Strike_Click">
                    <ToggleButton.Resources>
                        <Style TargetType="TextBlock"><Setter Property="TextDecorations" Value="Strikethrough"/></Style>
                    </ToggleButton.Resources>
                </ToggleButton>
                <Border Width="1" Background="{DynamicResource CardBorder}" Margin="4,2,8,2"/>
                <Button x:Name="SizeButton" Style="{StaticResource ToolButton}" Content="Size ▾"
                        ToolTip="Text size" Click="Size_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Small" Tag="11" Click="SizeItem_Click"/>
                            <MenuItem Header="Normal" Tag="14" Click="SizeItem_Click"/>
                            <MenuItem Header="Large" Tag="18" Click="SizeItem_Click"/>
                            <MenuItem Header="Heading" Tag="24" Click="SizeItem_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="TextColorButton" Style="{StaticResource ToolButton}" Content="A ▾"
                        ToolTip="Text colour" AutomationProperties.Name="Text color" Click="TextColor_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Black" Tag="#111111" Click="TextSwatch_Click" AutomationProperties.Name="Black text"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#111111" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Gray" Tag="#6B7280" Click="TextSwatch_Click" AutomationProperties.Name="Gray text"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#6B7280" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Red" Tag="#DC2626" Click="TextSwatch_Click" AutomationProperties.Name="Red text"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#DC2626" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Orange" Tag="#EA580C" Click="TextSwatch_Click" AutomationProperties.Name="Orange text"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#EA580C" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Green" Tag="#16A34A" Click="TextSwatch_Click" AutomationProperties.Name="Green text"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#16A34A" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Cyan" Tag="#0891B2" Click="TextSwatch_Click" AutomationProperties.Name="Cyan text"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#0891B2" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Blue" Tag="#2563EB" Click="TextSwatch_Click" AutomationProperties.Name="Blue text"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#2563EB" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Purple" Tag="#7C3AED" Click="TextSwatch_Click" AutomationProperties.Name="Purple text"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#7C3AED" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem Header="Automatic (theme default)" Tag="auto" Click="TextSwatch_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="HighlightButton" Style="{StaticResource ToolButton}" Content="🖍 ▾"
                        ToolTip="Highlight" AutomationProperties.Name="Text highlight" Click="Highlight_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Yellow" Tag="#FEF08A" Click="HighlightSwatch_Click" AutomationProperties.Name="Yellow highlight"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#FEF08A" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Green" Tag="#BBF7D0" Click="HighlightSwatch_Click" AutomationProperties.Name="Green highlight"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#BBF7D0" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Blue" Tag="#BFDBFE" Click="HighlightSwatch_Click" AutomationProperties.Name="Blue highlight"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#BFDBFE" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Pink" Tag="#FBCFE8" Click="HighlightSwatch_Click" AutomationProperties.Name="Pink highlight"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#FBCFE8" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Orange" Tag="#FED7AA" Click="HighlightSwatch_Click" AutomationProperties.Name="Orange highlight"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#FED7AA" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Purple" Tag="#E9D5FF" Click="HighlightSwatch_Click" AutomationProperties.Name="Purple highlight"><MenuItem.Icon><Rectangle Width="12" Height="12" Fill="#E9D5FF" Stroke="{DynamicResource CardBorder}"/></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem Header="None" Tag="none" Click="HighlightSwatch_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Border Width="1" Background="{DynamicResource CardBorder}" Margin="4,2,8,2"/>
                <ToggleButton x:Name="AlignLeftButton" Style="{StaticResource ToolToggle}" IsThreeState="True"
                        Content="⯇" ToolTip="Align left" AutomationProperties.Name="Align left"
                        Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Body}"/>
                <ToggleButton x:Name="AlignCenterButton" Style="{StaticResource ToolToggle}" IsThreeState="True"
                        Content="≡" ToolTip="Align centre" AutomationProperties.Name="Align center"
                        Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Body}"/>
                <ToggleButton x:Name="AlignRightButton" Style="{StaticResource ToolToggle}" IsThreeState="True"
                        Content="⯈" ToolTip="Align right" AutomationProperties.Name="Align right"
                        Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Body}"/>
                <Border Width="1" Background="{DynamicResource CardBorder}" Margin="4,2,8,2"/>
                <ToggleButton x:Name="BulletListButton" Style="{StaticResource ToolToggle}" IsThreeState="True"
                        Content="• List" ToolTip="Bullet list" AutomationProperties.Name="Bullet list"
                        Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Body}"/>
                <ToggleButton x:Name="NumberListButton" Style="{StaticResource ToolToggle}" IsThreeState="True"
                        Content="1. List" ToolTip="Numbered list" AutomationProperties.Name="Numbered list"
                        Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Body}"/>
                <Border Width="1" Background="{DynamicResource CardBorder}" Margin="4,2,8,2"/>
                <Button x:Name="LinkButton" Style="{StaticResource ToolButton}" Content="🔗 Link"
                        ToolTip="Insert or edit a link" Click="Link_Click"/>
                <Button x:Name="ClearButton" Style="{StaticResource ToolButton}" Content="Clear ✗"
                        ToolTip="Remove formatting from the selection" Click="ClearFormatting_Click"/>
                <Border Width="1" Background="{DynamicResource CardBorder}" Margin="4,2,8,2"/>
                <Button x:Name="InsertVarButton" Style="{StaticResource ToolButton}" Content="{}{{ }} ▾"
                        ToolTip="Insert a variable at the caret. Tip: type {{Response Name}} to include another response's text."
                        Click="InsertVar_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{}{{greeting}}" Click="InsertVarItem_Click"
                                      ToolTip="Good morning / afternoon / evening"/>
                            <MenuItem Header="{}{{date}}" Click="InsertVarItem_Click"
                                      ToolTip="Today's date (short)"/>
                            <MenuItem Header="{}{{time}}" Click="InsertVarItem_Click"
                                      ToolTip="Current time (short)"/>
                            <MenuItem Header="{}{{day}}" Click="InsertVarItem_Click"
                                      ToolTip="Day of week"/>
                            <MenuItem Header="{}{{date:yyyy-MM-dd}}" Click="InsertVarItem_Click"
                                      ToolTip="Date in a custom .NET format"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

            </WrapPanel>
        </Border>

        <!-- Body -->
        <RichTextBox x:Name="Body" Grid.Row="3" FontSize="14" Padding="8"
                     AutomationProperties.Name="Response body"
                     AutomationProperties.HelpText="Edit the formatted response content"
                     Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                      VerticalScrollBarVisibility="Auto"
                      AcceptsTab="True" SpellCheck.IsEnabled="True"
                      SelectionChanged="Body_SelectionChanged">
            <RichTextBox.Resources>
                <Style TargetType="Hyperlink">
                    <Setter Property="Foreground" Value="{DynamicResource Hyperlink}"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <!-- Error + actions -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Grid.Column="0" Margin="0,0,12,0"
                       Foreground="{DynamicResource Error}" FontSize="12"
                       AutomationProperties.LiveSetting="Assertive"
                       views:LiveRegion.Content="{Binding Text, RelativeSource={RelativeSource Self}}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Left" Visibility="Collapsed"/>
            <WrapPanel Grid.Column="1" MaxWidth="300" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"
                        Click="Cancel_Click"/>
                <!-- "Edit & insert" mode swaps Save for these one-off insert actions (no file saved). -->
                <Button x:Name="InsertPlainButton" Content="Insert plain" Style="{StaticResource ActionButton}"
                        Click="InsertPlain_Click" Visibility="Collapsed"
                        ToolTip="Insert the edited text as plain text (nothing is saved)"/>
                <Button x:Name="InsertButton" Content="Insert" Style="{StaticResource PrimaryButton}"
                        Click="Insert_Click" Visibility="Collapsed"
                        ToolTip="Insert the edited text into the app you were in (nothing is saved)"/>
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="Save_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
