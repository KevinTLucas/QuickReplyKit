<Window x:Class="QuickReplyKit.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit response"
        Width="640" Height="560" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#FFF4F4F8" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#FF8A8AA0"/>
        <SolidColorBrush x:Key="CardBorder" Color="#FFE2E2EC"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4F46E5"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0,0,2"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name + Category -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Field}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Category (folder — type a new path to create it)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryBox" IsEditable="True" StaysOpenOnEdit="True"
                          Style="{StaticResource Field}"/>
            </StackPanel>
        </Grid>

        <!-- App + Tags -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="App (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AppBox" Style="{StaticResource Field}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Tags (comma-separated)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TagsBox" Style="{StaticResource Field}"/>
            </StackPanel>
        </Grid>

        <!-- Formatting toolbar -->
        <Border Grid.Row="2" Background="White" CornerRadius="8,8,0,0"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1,1,1,0" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" FontWeight="Bold" Content="B"
                        ToolTip="Bold (Ctrl+B)"
                        Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Body}"/>
                <Button Style="{StaticResource ToolButton}" FontStyle="Italic" Content="I"
                        ToolTip="Italic (Ctrl+I)"
                        Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Body}"/>
                <Button Style="{StaticResource ToolButton}" Content="U"
                        ToolTip="Underline (Ctrl+U)"
                        Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Body}">
                    <Button.Resources>
                        <Style TargetType="TextBlock"><Setter Property="TextDecorations" Value="Underline"/></Style>
                    </Button.Resources>
                </Button>
                <Border Width="1" Background="{StaticResource CardBorder}" Margin="4,2,8,2"/>
                <Button Style="{StaticResource ToolButton}" Content="• List" ToolTip="Bullet list"
                        Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Body}"/>
                <Button Style="{StaticResource ToolButton}" Content="1. List" ToolTip="Numbered list"
                        Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Body}"/>
                <Border Width="1" Background="{StaticResource CardBorder}" Margin="4,2,8,2"/>
                <Button x:Name="LinkButton" Style="{StaticResource ToolButton}" Content="🔗 Link"
                        ToolTip="Insert or edit a link" Click="Link_Click"/>
                <Button x:Name="ClearButton" Style="{StaticResource ToolButton}" Content="Clear ✗"
                        ToolTip="Remove formatting from the selection" Click="ClearFormatting_Click"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <RichTextBox x:Name="Body" Grid.Row="3" FontSize="14" Padding="8"
                     BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsTab="True" SpellCheck.IsEnabled="True"/>

        <!-- Error + actions -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FFB91C1C" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Left" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"
                        Click="Cancel_Click"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
