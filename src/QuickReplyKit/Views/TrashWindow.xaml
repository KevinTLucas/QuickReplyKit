<Window x:Class="QuickReplyKit.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trash" SizeToContent="Height" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="Deleted responses" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock x:Name="RetentionHint" Foreground="{DynamicResource TextMuted}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,2,0,8"/>
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="TrashList" Height="240" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource TextPrimary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="2,6,0,0"
                   Text="Trash is empty." Visibility="Collapsed"/>
        <Grid Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="RestoreButton" Content="Restore" Style="{StaticResource Btn}" Click="Restore_Click"/>
                <Button x:Name="DeleteButton" Content="Delete forever" Style="{StaticResource Btn}" Click="DeleteForever_Click"/>
                <Button x:Name="EmptyButton" Content="Empty trash" Style="{StaticResource Btn}" Click="Empty_Click"/>
            </StackPanel>
            <Button Content="Close" Style="{StaticResource Btn}" Margin="0" HorizontalAlignment="Right" IsCancel="True"/>
        </Grid>
    </StackPanel>
</Window>
