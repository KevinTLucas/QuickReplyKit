<Window x:Class="QuickReplyKit.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickReplyKit.Views"
        Title="Trash" Width="500" Height="390" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Deleted items" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock Grid.Row="1" x:Name="RetentionHint" Foreground="{DynamicResource TextMuted}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,2,0,8"/>
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="TrashList" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Deleted responses and folders"
                     AutomationProperties.HelpText="Select an item to restore or permanently delete"
                     Foreground="{DynamicResource TextPrimary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3" AutomationProperties.Name="{Binding Name}"
                                    AutomationProperties.HelpText="{Binding Sub}">
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Sub}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <TextBlock Grid.Row="3" x:Name="EmptyHint" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="2,6,0,0"
                   AutomationProperties.LiveSetting="Polite"
                   views:LiveRegion.Content="{Binding Visibility, RelativeSource={RelativeSource Self}}"
                   Text="Trash is empty." Visibility="Collapsed"/>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="RestoreButton" Content="_Restore" AutomationProperties.Name="Restore selected item"
                        Style="{StaticResource Btn}" Click="Restore_Click"/>
                <Button x:Name="DeleteButton" Content="_Delete forever" AutomationProperties.Name="Delete selected item forever"
                        Style="{StaticResource Btn}" Click="DeleteForever_Click"/>
                <Button x:Name="EmptyButton" Content="_Empty trash" AutomationProperties.Name="Empty trash"
                        Style="{StaticResource Btn}" Click="Empty_Click"/>
            </StackPanel>
            <Button Content="_Close" AutomationProperties.Name="Close Trash" Style="{StaticResource Btn}"
                    Margin="0" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
