<Window x:Class="QuickReplyKit.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, RelativeSource={RelativeSource Self}}"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptLabel" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="13"/>
        <ComboBox x:Name="Input" IsEditable="True" StaysOpenOnEdit="True" FontSize="14"
                  Padding="6,4" Foreground="{DynamicResource TextPrimary}"
                  Background="{DynamicResource CardBg}" Loaded="Input_Loaded"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,6,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Style="{StaticResource ActionButton}" IsDefault="True"
                    Click="Ok_Click"/>
            <Button Content="Cancel" Style="{StaticResource ActionButton}" Margin="0"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
