<Window x:Class="QuickReplyKit.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Back up / Restore Library" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="Library snapshots" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"
                   Text="Snapshots are taken automatically before an import, and whenever you click “Back up now”. Restoring replaces your current library after taking an undo snapshot. Modern snapshots also restore local settings and restart QuickReplyKit; legacy snapshots restore only the library."/>
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="BackupList" Height="200" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource TextPrimary}" DisplayMemberPath="Display"/>
        </Border>
        <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="2,6,0,0"
                   Text="No snapshots yet." Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Back up now" Style="{StaticResource Btn}" Click="BackupNow_Click"/>
            <Button x:Name="RestoreButton" Content="Restore selected" Style="{StaticResource Btn}" Click="Restore_Click"/>
            <Button Content="Open folder" Style="{StaticResource Btn}" Click="OpenFolder_Click"/>
            <Button Content="Close" Style="{StaticResource Btn}" Margin="0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
