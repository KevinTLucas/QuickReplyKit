<Window x:Class="QuickReplyKit.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, RelativeSource={RelativeSource Self}}"
        SizeToContent="Height" Width="440" MaxWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="88"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                   AutomationProperties.Name="Confirmation message"/>
        <StackPanel x:Name="ButtonBar" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
