<Window x:Class="QuickReplyKit.Views.HotkeyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Width="560" Height="560" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter -->
        <TextBox Grid.Row="0" x:Name="FilterBox" FontSize="13"
                 AutomationProperties.Name="Filter shortcuts"
                 Style="{StaticResource Input}" TextChanged="FilterBox_TextChanged"
                 ToolTip="Filter the list below by shortcut or response name"/>

        <TextBlock Grid.Row="1" Text="All shortcuts" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>

        <!-- List -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                <ItemsControl x:Name="RowsList">
                    <AutomationProperties.Name>Configured shortcuts</AutomationProperties.Name>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7" Margin="1,1,1,0" Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Gesture}" FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Mode}" Foreground="{DynamicResource TextMuted}"
                                                   FontSize="10" Visibility="{Binding HasMode, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                        <TextBlock Text="{Binding Target}" ToolTip="{Binding Target}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding IsResponse, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Edit" Style="{StaticResource ActionButton}"
                                                Tag="{Binding RelativePath}" Click="Edit_Click"/>
                                        <Button Content="Clear" Style="{StaticResource ActionButton}"
                                                Tag="{Binding RelativePath}" Click="Clear_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Warning}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Text="Assign per-response keys from a response's right-click menu. Change the launcher key in Settings."/>
            <Button Grid.Column="1" Content="Close" Style="{StaticResource ActionButton}"
                    MinWidth="80" Padding="12,5" IsCancel="True" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
