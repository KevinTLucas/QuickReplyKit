<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QuickReplyKit</AssemblyName>
    <RootNamespace>QuickReplyKit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <!-- WPF drives DPI via app.manifest (PerMonitorV2); silence the WinForms-only DPI analyzer. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Ship only the invariant/English resources; keeps the portable exe lean. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Portable single-file publish (see README for the full command). Passing
       -p:PublishSingleFile=true is then enough to also pull the native libs into the
       self-extracting exe and compress it. Trimming is intentionally NOT enabled (WPF is
       not trim-safe). DefaultLibrary content copies loose beside the exe (see below), which
       is what App.xaml.cs seeds from (AppContext.BaseDirectory then DefaultLibrary). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickReplyKit.Core\QuickReplyKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- WPF and WinForms both define Application/KeyEventArgs/etc. Keep WPF as the default;
       WinForms types (tray icon) are reached via the `Forms`/`Drawing` aliases. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- Bundle the default library so first run has example content -->
  <ItemGroup>
    <None Include="..\..\assets\DefaultLibrary\**\*">
      <Link>DefaultLibrary\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
